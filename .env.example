# Copy this to `.env` (same folder as docker-compose.yml) and fill in real
# values on the VM. docker-compose reads it automatically.
# Signs every login token. Now that auth is real, a placeholder here means
# anyone who can read this repo can mint a token for any account — so the app
# refuses to start against Postgres with a known default value.
#   SECRET_KEY=$(openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_USER=dogapp
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=dogppelganger
