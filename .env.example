# Copy this to `.env` (same folder as docker-compose.yml) and fill in real
# values on the VM. docker-compose reads it automatically.
# Signs every login token. Now that auth is real, a placeholder here means
# anyone who can read this repo can mint a token for any account — so the app
# refuses to start against Postgres with a known default value.
#   SECRET_KEY=$(openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-string
# ⚠️ On a server that has already run once, these must MATCH what the `dbdata`
# volume was created with — they are not a password you can change from here.
# Postgres only reads POSTGRES_PASSWORD when it first initialises its data
# directory; afterwards it is ignored, so a new value here just makes the API
# build a connection string the database rejects, and the stack falls over with
# an auth error that looks nothing like the cause.
#
# To see what a running deployment is actually using:
#     docker compose exec model printenv DATABASE_URL
#
# To rotate it for real, change it in the database first, then match it here:
#     docker compose exec db psql -U dogapp -d dogppelganger \
#         -c "ALTER USER dogapp PASSWORD 'new-password';"
#
# The `db` service publishes no ports, so Postgres is only reachable from inside
# the compose network.
POSTGRES_USER=dogapp
POSTGRES_PASSWORD=dogapp
POSTGRES_DB=dogppelganger
